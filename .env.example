# Copier ce fichier en .env (ignoré par Git) puis renseigner au moins une clé API.

# --- LLM : ordre de fallback (noms séparés par des virgules) ---
# Un fournisseur sans clé API est ignoré au démarrage.
# "ollama" n'est joignable que si la stack tourne avec --profile local-llm.
LLM_CHAIN=groq,gemini,ollama

# Groq (free tier, sans carte bancaire) : https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Google AI Studio (free tier, sans carte bancaire) : https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# LLM local (profil local-llm). 3B : seul ordre de grandeur réaliste avec 4 Go de VRAM / CPU.
OLLAMA_LLM_MODEL=qwen2.5:3b

# --- Embeddings & reranking (locaux) ---
EMBEDDING_MODEL=bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# --- Base de données ---
POSTGRES_DB=regwatch
POSTGRES_USER=regwatch
POSTGRES_PASSWORD=regwatch
POSTGRES_PORT=5432

# --- Ports exposés sur l'hôte ---
# 8080 est souvent déjà pris (listener Oracle XE, Tomcat, Jenkins…) : changer BACKEND_PORT si besoin.
# Le frontend joint le backend par le réseau Docker, il n'est pas concerné.
BACKEND_PORT=8080
FRONTEND_PORT=4200
